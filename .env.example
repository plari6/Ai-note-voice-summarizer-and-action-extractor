# ---------- AI (multi-model fallback) ----------
GEMINI_API_KEY=            # https://aistudio.google.com/apikey  (audio transcription + task extraction)
GROQ_API_KEY=              # https://console.groq.com/keys       (free Whisper audio fallback + fast text model)
NVIDIA_API_KEY=            # https://build.nvidia.com            (text fallback, free credits)
OPENROUTER_API_KEY=        # https://openrouter.ai/keys          (":free" text models)
# OPENAI_API_KEY=          # optional extra audio fallback (gpt-4o-mini-transcribe)
# OLLAMA_BASE_URL=http://localhost:11434/v1   # local text model, fully offline analysis

# Order of models (provider:model, comma separated). Defaults are in src/transcriber.js and src/ai/chain.js.
# AUDIO_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,gemini:gemini-flash-latest,groq:whisper-large-v3-turbo,groq:whisper-large-v3
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-flash-latest,groq:llama-3.3-70b-versatile,openrouter:openrouter/free
AUDIO_TIMEOUT_MS=180000    # per audio model
AUDIO_TOTAL_BUDGET_MS=600000
AI_TIMEOUT_MS=45000        # per text model while another one is left to try
AI_TOTAL_BUDGET_MS=150000
AI_HEDGE_MS=30000          # start the next text model in parallel if the current one is silent this long (0 = off)

# ---------- About the person dictating ----------
OWNER_NAME=                # e.g. "Dana Levi" - their tasks show as "Me", and messages are signed with it
NOTE_CONTEXT=              # e.g. "CEO of Brightline, a 40-person B2B SaaS company. Sarah = Head of Sales, Omar = CFO"
VOCABULARY=                # names/terms to spell right, e.g. "Hartwell, Datafront, Priya, QBR"
OUTPUT_LANGUAGE=English    # or "auto" = same language as the voice note
# NOTE_LANGUAGE=           # force the spoken language (default: auto-detect)
TIMEZONE=                  # e.g. Europe/London (default: this computer's zone)

# ---------- Integrations ----------
WEBHOOK_URL=               # Zapier / Make / n8n catch hook -> Asana, ClickUp, Monday, Todoist, Jira, Notion, HubSpot
WEBHOOK_SECRET=            # optional, signs the body: X-Voice-Tasks-Signature: sha256=<hmac>
SLACK_WEBHOOK_URL=         # Slack incoming webhook for a summary post

# ---------- Telegram bot (voice-tasks telegram) ----------
TELEGRAM_BOT_TOKEN=        # from @BotFather
TELEGRAM_ALLOWED_CHAT_IDS= # comma separated; send /help to the bot to see your id
PENDING_RETRY_MINUTES=10   # retry notes that arrived while AI was down

# ---------- HTTP API (voice-tasks serve) ----------
PORT=3000
API_TOKEN=                 # required in production: Authorization: Bearer <API_TOKEN>
MAX_UPLOAD_MB=100

# ---------- Storage ----------
# DATA_DIR=./data          # cache, task register, pending queue
# OUTPUT_DIR=./output      # reports
